# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
DB_CONNECTION=pg
DB_DATABASE=battlecatsdle
DB_USER=battlecatsdle
DB_PASSWORD=
DB_PORT=5432
DB_HOST=127.0.0.1

# Test database (docker-compose "postgres-test" service)
DB_TEST_DATABASE=battlecatsdle_test
DB_TEST_USER=battlecatsdle_test
DB_TEST_PASSWORD=battlecatsdle_test
DB_TEST_PORT=5433
DB_TEST_HOST=127.0.0.1

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5555
